# Copy to .env and adjust. Every value has a default, so .env is optional.

# Stand under test
INTERSHOP_BASE_URL=https://intershop6.skillbox.ru
INTERSHOP_STAND_NAME=intershop6 (public demo)

# Timeouts
INTERSHOP_API_TIMEOUT_S=20
INTERSHOP_UI_TIMEOUT_MS=15000

# Web artifacts attached to Allure: "on-failure" or "always"
INTERSHOP_WEB_ARTIFACTS=on-failure

# Fix mimesis seed to reproduce generated data (empty = random)
INTERSHOP_DATA_SEED=
